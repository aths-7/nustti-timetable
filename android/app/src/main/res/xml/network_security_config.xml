<?xml version="1.0" encoding="utf-8"?>
<!--
  课表数据源为 https://jwgl.nustti.edu.cn（https，使用系统证书链校验）。
  保留明文放行仅为便于局域网内自行调试，教务系统请求本身全程走 https。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
