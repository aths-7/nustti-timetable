<?xml version="1.0" encoding="utf-8"?>
<!-- 本地缓存详情页：深紫渐变背景 + 半透明玻璃卡片，标题栏含返回 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_about_window">

    <!-- 标题栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#E5E7EB"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="本地缓存"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#F9FAFB" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 卡片：缓存统计 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_about_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="缓存统计"
                    android:textColor="#F9FAFB"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCacheStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#E5E7EB"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_about_card"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="说明：\n课表数据缓存在应用私有目录（无需联网即可查看最近一次课表）；应用缓存目录用于存放运行期临时文件。\n清除缓存会删除缓存目录内容与课表缓存，不会影响账号设置、背景图片等个人数据。"
                android:textColor="#9CA3AF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnClearCache"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="清除缓存"
                android:textAllCaps="false"
                android:textColor="#F87171" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
