<?xml version="1.0" encoding="utf-8"?>
<!-- 关于与更新详情页：深紫渐变背景 + 半透明玻璃卡片，标题栏含返回 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_about_window">

    <!-- 标题栏：返回 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="‹"
            android:textSize="30sp"
            android:textColor="#E5E7EB"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="关于与更新"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#F9FAFB" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 应用图标占位 + 名称 -->
            <TextView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_about_icon"
                android:gravity="center"
                android:text="课"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F9FAFB" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:textSize="14sp"
                android:textColor="#9CA3AF" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="检查更新" />

            <!-- 开发者信息 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_about_card"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:text="开发者：aths-7\n南泰科课表（nustti-timetable）\n用于查询南京理工大学泰州科技学院课表，客户端直连教务系统官网，数据不经过任何中间服务端。"
                android:textColor="#E5E7EB"
                android:textSize="14sp" />

            <!-- 开源仓库 -->
            <TextView
                android:id="@+id/tvRepo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_about_card"
                android:padding="16dp"
                android:lineSpacingExtra="4dp"
                android:text="开源仓库\nhttps://github.com/aths-7/nustti-timetable\n点击打开 GitHub 仓库"
                android:textColor="#93C5FD"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
